<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hills & Peaks | Ultimate Mountain & Outdoor Guide</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        emerald: {
                            400: '#34d399',
                            500: '#10b981',
                            600: '#059669',
                            900: '#064e3b',
                        },
                        amber: {
                            500: '#f59e0b',
                        },
                        slate: {
                            800: '#1e293b',
                            850: '#172033',
                            900: '#0f172a',
                            950: '#020617',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js for Elevation Profile Graphing -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Three.js for 3D Mountain Terrain Visualizer -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Lucide Icons / Canvas Helpers -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(16, 185, 129, 0.3);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(16, 185, 129, 0.6);
        }

        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        
        .light .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }

        .glow-emerald {
            box-shadow: 0 0 25px -5px rgba(16, 185, 129, 0.3);
        }

        .gradient-text {
            background: linear-gradient(135deg, #34d399 0%, #3b82f6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col transition-colors duration-300">

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 glass-panel border-b border-slate-800 transition-colors duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('home')">
                <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-slate-950 text-xl font-black shadow-lg shadow-emerald-900/40">
                    <i class="fa-solid font-bold fa-mountain"></i>
                </div>
                <div>
                    <span class="text-2xl font-black tracking-wider uppercase font-sans text-slate-100">Hills<span class="text-emerald-400">&</span>Peaks</span>
                    <p class="text-xs text-slate-400 font-medium tracking-widest uppercase">Alpine & Trail Guide</p>
                </div>
            </div>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
                <button onclick="switchTab('home')" id="nav-home" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all text-emerald-400 bg-slate-800/80">
                    <i class="fa-solid fa-compass mr-2"></i>Explore
                </button>
                <button onclick="switchTab('directory')" id="nav-directory" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800/50 transition-all">
                    <i class="fa-solid fa-mountain-sun mr-2"></i>Peaks
                </button>
                <button onclick="switchTab('3dmap')" id="nav-3dmap" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800/50 transition-all">
                    <i class="fa-solid fa-cubes mr-2"></i>3D Visualizer
                </button>
                <button onclick="switchTab('route-planner')" id="nav-route-planner" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800/50 transition-all">
                    <i class="fa-solid fa-route mr-2"></i>Route Planner
                </button>
                <button onclick="switchTab('gear-checklist')" id="nav-gear-checklist" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800/50 transition-all">
                    <i class="fa-solid fa-list-check mr-2"></i>Gear & Checklist
                </button>
                <button onclick="switchTab('trail-log')" id="nav-trail-log" class="nav-btn px-4 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:text-emerald-400 hover:bg-slate-800/50 transition-all">
                    <i class="fa-solid fa-book-bookmark mr-2"></i>Trail Log
                </button>
            </nav>

            <!-- Actions & Theme Toggle -->
            <div class="flex items-center space-x-3">
                <button id="themeToggle" onclick="toggleTheme()" class="w-10 h-10 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-300 hover:text-amber-400 transition-colors">
                    <i class="fa-solid fa-moon text-lg" id="themeIcon"></i>
                </button>
                <button onclick="openModal('quickStats')" class="hidden sm:flex items-center space-x-2 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold px-4 py-2 rounded-lg transition-all shadow-md shadow-emerald-500/20 text-sm">
                    <i class="fa-solid fa-trophy"></i>
                    <span>Logbook</span>
                </button>
                <!-- Mobile Menu Button -->
                <button onclick="toggleMobileMenu()" class="md:hidden w-10 h-10 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-300">
                    <i class="fa-solid fa-bars text-xl" id="mobileMenuIcon"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div id="mobileMenu" class="hidden md:hidden border-t border-slate-800 bg-slate-900/95 px-4 pt-3 pb-6 space-y-2">
            <button onclick="switchTab('home'); toggleMobileMenu();" class="w-full text-left px-4 py-2.5 rounded-lg text-sm font-semibold text-slate-200 hover:bg-slate-800 flex items-center">
                <i class="fa-solid fa-compass w-6 text-emerald-400"></i> Explore & Overview
            </button>
            <button onclick="switchTab('directory'); toggleMobileMenu();" class="w-full text-left px-4 py-2.5 rounded-lg text-sm font-semibold text-slate-200 hover:bg-slate-800 flex items-center">
                <i class="fa-solid fa-mountain-sun w-6 text-emerald-400"></i> Peak Directory
            </button>
            <button onclick="switchTab('3dmap'); toggleMobileMenu();" class="w-full text-left px-4 py-2.5 rounded-lg text-sm font-semibold text-slate-200 hover:bg-slate-800 flex items-center">
                <i class="fa-solid fa-cubes w-6 text-emerald-400"></i> 3D Terrain Map
            </button>
            <button onclick="switchTab('route-planner'); toggleMobileMenu();" class="w-full text-left px-4 py-2.5 rounded-lg text-sm font-semibold text-slate-200 hover:bg-slate-800 flex items-center">
                <i class="fa-solid fa-route w-6 text-emerald-400"></i> Interactive Route Planner
            </button>
            <button onclick="switchTab('gear-checklist'); toggleMobileMenu();" class="w-full text-left px-4 py-2.5 rounded-lg text-sm font-semibold text-slate-200 hover:bg-slate-800 flex items-center">
                <i class="fa-solid fa-list-check w-6 text-emerald-400"></i> Packing & Gear Guide
            </button>
            <button onclick="switchTab('trail-log'); toggleMobileMenu();" class="w-full text-left px-4 py-2.5 rounded-lg text-sm font-semibold text-slate-200 hover:bg-slate-800 flex items-center">
                <i class="fa-solid fa-book-bookmark w-6 text-emerald-400"></i> Personal Trail Log
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">

        <!-- ================= TAB 1: HOME / EXPLORE HERO ================= -->
        <section id="tab-home" class="tab-content space-y-12">
            <!-- Hero Banner -->
            <div class="relative rounded-3xl overflow-hidden border border-slate-800 bg-gradient-to-r from-slate-900 via-slate-900/90 to-slate-950 p-8 sm:p-12 lg:p-16 flex flex-col justify-center shadow-2xl">
                <!-- Background Graphic Overlay -->
                <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
                <div class="absolute -right-20 -top-20 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10 max-w-3xl space-y-6">
                    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold tracking-wide uppercase">
                        <i class="fa-solid fa-bolt text-xs"></i>
                        <span>Summit Adventure Engine 3.0</span>
                    </div>
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight">
                        Conquer Heights. <br/>
                        <span class="gradient-text">Log Every Elevation.</span>
                    </h1>
                    <p class="text-slate-300 text-base sm:text-lg max-w-2xl font-normal leading-relaxed">
                        Your ultimate companion for mountain exploration, peak bagging, interactive elevation profile mapping, real-time alpine weather safety, and expedition gear tracking.
                    </p>

                    <!-- Quick Search Bar -->
                    <div class="pt-4 flex flex-col sm:flex-row gap-3 max-w-xl">
                        <div class="relative flex-grow">
                            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                            <input type="text" id="heroSearchInput" placeholder="Search Matterhorn, Mont Blanc, Denali..." class="w-full pl-11 pr-4 py-3.5 bg-slate-800/90 border border-slate-700/80 rounded-xl text-slate-100 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-sm">
                        </div>
                        <button onclick="handleHeroSearch()" class="px-6 py-3.5 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold rounded-xl transition-all flex items-center justify-center space-x-2 shadow-lg shadow-emerald-500/20 text-sm whitespace-nowrap">
                            <span>Find Peaks</span>
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                    </div>

                    <!-- Quick Stats Badges -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-slate-800/80">
                        <div>
                            <div class="text-2xl font-black text-slate-100" id="stat-peaks-count">12,450+</div>
                            <div class="text-xs text-slate-400 font-medium">Mapped Peaks</div>
                        </div>
                        <div>
                            <div class="text-2xl font-black text-emerald-400" id="stat-logged-count">4,820m</div>
                            <div class="text-xs text-slate-400 font-medium">Max Elevation Mapped</div>
                        </div>
                        <div>
                            <div class="text-2xl font-black text-slate-100">100%</div>
                            <div class="text-xs text-slate-400 font-medium">Interactive Profiles</div>
                        </div>
                        <div>
                            <div class="text-2xl font-black text-emerald-400">24/7</div>
                            <div class="text-xs text-slate-400 font-medium">Live Conditions</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Weather Conditions & Featured Peaks Section -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Weather / Live Station Widget -->
                <div class="lg:col-span-1 glass-panel rounded-2xl p-6 border border-slate-800 space-y-6">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center">
                                <i class="fa-solid fa-cloud-sun text-lg"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-100 text-base">Mountain Weather</h3>
                                <p class="text-xs text-slate-400">Live Elevation Forecast</p>
                            </div>
                        </div>
                        <select id="weatherStationSelect" onchange="updateWeatherWidget()" class="bg-slate-900 border border-slate-700 rounded-lg text-xs text-slate-200 px-3 py-1.5 focus:outline-none focus:border-emerald-500">
                            <option value="Matterhorn">Matterhorn (4,478m)</option>
                            <option value="Mont Blanc">Mont Blanc (4,809m)</option>
                            <option value="Mount Rainier">Mount Rainier (4,392m)</option>
                            <option value="Denali">Denali (6,190m)</option>
                            <option value="Kilimanjaro">Kilimanjaro (5,895m)</option>
                        </select>
                    </div>

                    <!-- Weather Display Box -->
                    <div id="weatherDisplay" class="bg-slate-900/80 rounded-xl p-5 border border-slate-800 space-y-4">
                        <!-- Rendered by JS -->
                    </div>

                    <!-- Avalanche & Trail Status -->
                    <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs flex items-start space-x-3">
                        <i class="fa-solid fa-triangle-exclamation text-amber-400 text-base mt-0.5"></i>
                        <div>
                            <span class="font-bold block mb-0.5">Alpine Advisory</span>
                            <p class="text-slate-300 leading-relaxed" id="weatherAdvisoryText">Moderate wind speed above 3,500m. Carry proper windproof shell and traction gear.</p>
                        </div>
                    </div>
                </div>

                <!-- Featured Peaks Grid -->
                <div class="lg:col-span-2 space-y-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-2xl font-black text-slate-100">Featured Summits</h2>
                            <p class="text-slate-400 text-sm">Top rated peaks for your next expedition</p>
                        </div>
                        <button onclick="switchTab('directory')" class="text-emerald-400 hover:text-emerald-300 text-sm font-semibold flex items-center space-x-1">
                            <span>View All</span>
                            <i class="fa-solid fa-chevron-right text-xs"></i>
                        </button>
                    </div>

                    <div id="featuredPeaksContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <!-- Populated by Javascript -->
                    </div>
                </div>
            </div>

            <!-- Quick Action Cards Section -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div onclick="switchTab('3dmap')" class="glass-panel p-6 rounded-2xl border border-slate-800 hover:border-emerald-500/50 transition-all cursor-pointer group">
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-cube"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-100 mb-2">3D Topo Terrain Render</h3>
                    <p class="text-slate-400 text-sm">Visualize peak geometry, ridgelines, and elevation contours in interactive 3D WebGL mode.</p>
                </div>

                <div onclick="switchTab('route-planner')" class="glass-panel p-6 rounded-2xl border border-slate-800 hover:border-emerald-500/50 transition-all cursor-pointer group">
                    <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-route"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-100 mb-2">Elevation Profile Plotter</h3>
                    <p class="text-slate-400 text-sm">Draw custom waypoints to dynamically generate ascent gradients, distance, and difficulty.</p>
                </div>

                <div onclick="switchTab('gear-checklist')" class="glass-panel p-6 rounded-2xl border border-slate-800 hover:border-emerald-500/50 transition-all cursor-pointer group">
                    <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-clipboard-check"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-100 mb-2">Interactive Expedition Gear</h3>
                    <p class="text-slate-400 text-sm">Manage customizable packing checklists by trail difficulty, season, and summit duration.</p>
                </div>
            </div>
        </section>

        <!-- ================= TAB 2: PEAK DIRECTORY & FILTERS ================= -->
        <section id="tab-directory" class="tab-content hidden space-y-8">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-black text-slate-100">Peak Explorer Directory</h1>
                    <p class="text-slate-400 text-sm">Filter, search, and inspect world-renowned peaks & mountain ranges</p>
                </div>
                <div class="flex items-center space-x-3">
                    <span class="text-xs text-slate-400 font-medium" id="directoryResultsCount">Showing 8 Peaks</span>
                </div>
            </div>

            <!-- Filters Bar -->
            <div class="glass-panel p-5 rounded-2xl border border-slate-800 space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Search Input -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1">Search Name / Region</label>
                        <div class="relative">
                            <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                            <input type="text" id="filterSearch" oninput="applyFilters()" placeholder="e.g., Alps, Rainier..." class="w-full pl-9 pr-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-emerald-500">
                        </div>
                    </div>

                    <!-- Difficulty Filter -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1">Difficulty Level</label>
                        <select id="filterDifficulty" onchange="applyFilters()" class="w-full py-2 px-3 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-emerald-500">
                            <option value="all">All Difficulties</option>
                            <option value="Moderate">Moderate</option>
                            <option value="Strenuous">Strenuous</option>
                            <option value="Technical">Technical / Expert</option>
                        </select>
                    </div>

                    <!-- Min Altitude Filter -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1">Min Altitude (Meters)</label>
                        <select id="filterAltitude" onchange="applyFilters()" class="w-full py-2 px-3 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-emerald-500">
                            <option value="0">Any Elevation</option>
                            <option value="3000">3,000m +</option>
                            <option value="4000">4,000m +</option>
                            <option value="5000">5,000m +</option>
                        </select>
                    </div>

                    <!-- Range / Continent Filter -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1">Mountain Range</label>
                        <select id="filterRange" onchange="applyFilters()" class="w-full py-2 px-3 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-emerald-500">
                            <option value="all">All Ranges</option>
                            <option value="Alps">Swiss & French Alps</option>
                            <option value="Cascades">Cascades Range</option>
                            <option value="Alaska Range">Alaska Range</option>
                            <option value="Himalayas">Himalayas</option>
                            <option value="Andes">Andes Range</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Peaks Grid -->
            <div id="peakDirectoryGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Rendered dynamically -->
            </div>
        </section>

        <!-- ================= TAB 3: 3D MOUNTAIN VISUALIZER ================= -->
        <section id="tab-3dmap" class="tab-content hidden space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-black text-slate-100">3D Interactive Terrain Engine</h1>
                    <p class="text-slate-400 text-sm">Drag to rotate, scroll to zoom, and select peak presets for procedural heightmap inspection.</p>
                </div>
                <div class="flex items-center space-x-3">
                    <button onclick="reset3DCamera()" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-xs font-semibold text-slate-200 transition-colors">
                        <i class="fa-solid fa-rotate-left mr-1.5"></i>Reset View
                    </button>
                    <select id="preset3DSelect" onchange="load3DPreset()" class="bg-slate-800 border border-slate-700 text-xs font-semibold text-emerald-400 px-3.5 py-2 rounded-lg focus:outline-none focus:border-emerald-500">
                        <option value="matterhorn">Preset: Matterhorn Ridge</option>
                        <option value="rainier">Preset: Mount Rainier Crater</option>
                        <option value="everest">Preset: Everest Col Range</option>
                        <option value="canyon">Preset: Alpine Valley & Pass</option>
                    </select>
                </div>
            </div>

            <!-- 3D Canvas Box -->
            <div class="relative w-full h-[550px] bg-slate-900 rounded-2xl overflow-hidden border border-slate-800 shadow-2xl">
                <div id="threejs-container" class="w-full h-full cursor-grab active:cursor-grabbing"></div>

                <!-- Floating Canvas Controls Overlay -->
                <div class="absolute top-4 left-4 glass-panel p-4 rounded-xl border border-slate-800 space-y-3 max-w-xs text-xs">
                    <div class="font-bold text-slate-200 flex items-center justify-between">
                        <span>Terrain Controls</span>
                        <i class="fa-solid fa-sliders text-emerald-400"></i>
                    </div>
                    <div>
                        <label class="block text-slate-400 mb-1">Height Scaling: <span id="wireframeScaleVal">1.2x</span></label>
                        <input type="range" id="wireframeScale" min="0.5" max="3" step="0.1" value="1.2" oninput="update3DHeight(this.value)" class="w-full accent-emerald-500">
                    </div>
                    <div class="flex items-center justify-between pt-1">
                        <span class="text-slate-400">Wireframe Overlay</span>
                        <input type="checkbox" id="wireframeToggle" onchange="toggle3DWireframe(this.checked)" class="accent-emerald-500 w-4 h-4 rounded">
                    </div>
                    <div class="flex items-center justify-between pt-1">
                        <span class="text-slate-400">Auto Orbit</span>
                        <input type="checkbox" id="orbitToggle" checked onchange="toggle3DOrbit(this.checked)" class="accent-emerald-500 w-4 h-4 rounded">
                    </div>
                </div>

                <!-- Floating Stats Badge -->
                <div class="absolute bottom-4 right-4 glass-panel px-4 py-2.5 rounded-xl border border-slate-800 text-xs text-slate-300 space-y-1">
                    <div class="flex items-center space-x-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span class="font-bold text-slate-100" id="3dPeakTitle">Matterhorn Sharp Pyramid</span>

                `;
            }).join('');

            document.getElementById('totalPeaksBagged').textContent = initialLogs.length;
            document.getElementById('totalGainLogged').textContent = `${totalAlt.toLocaleString()} m`;
        }

        function handleSaveLog(e) {
            e.preventDefault();
            const name = document.getElementById('logInputName').value;
            const alt = parseInt(document.getElementById('logInputAlt').value, 10);
            const date = document.getElementById('logInputDate').value;
            const notes = document.getElementById('logInputNotes').value;

            initialLogs.unshift({
                id: Date.now(),
                name,
                alt,
                date,
                notes
            });

            closeModal();
            renderTrailLogs();
        }

        function openPeakModal(peakId) {
            const peak = samplePeaks.find(p => p.id === peakId);
            if (!peak) return;

            selectedModalPeak = peak;
            document.getElementById('modalPeakName').textContent = peak.name;
            document.getElementById('modalPeakRange').textContent = `${peak.range} • ${peak.country}`;
            document.getElementById('modalPeakAlt').textContent = `${peak.elevation.toLocaleString()} m`;
            document.getElementById('modalPeakDiff').textContent = peak.difficulty;
            document.getElementById('modalPeakTime').textContent = peak.time;
            document.getElementById('modalPeakDesc').textContent = peak.desc;

            const tagsContainer = document.getElementById('modalPeakTags');
            tagsContainer.innerHTML = peak.tags.map(t => `<span class="px-3 py-1 bg-slate-800 text-slate-300 rounded-lg text-xs font-semibold">${t}</span>`).join('');

            openModal('peakDetailModal');
        }

        function logThisPeakFromModal() {
            if (!selectedModalPeak) return;
            closeModal();
            switchTab('trail-log');
            openModal('addLogModal');
            document.getElementById('logInputName').value = selectedModalPeak.name;
            document.getElementById('logInputAlt').value = selectedModalPeak.elevation;
        }

        function openModal(modalId) {
            document.getElementById('modalOverlay').classList.remove('hidden');
            document.querySelectorAll('.modal-card').forEach(m => m.classList.add('hidden'));
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('modalOverlay').classList.add('hidden');
            document.querySelectorAll('.modal-card').forEach(m => m.classList.add('hidden'));
        }

        // Initialize on DOM Load
        window.onload = function() {
            renderFeaturedPeaks();
            renderPeakDirectory();
            updateWeatherWidget();
            renderGearChecklist();
            renderTrailLogs();
        };
    </script>
</body>
</html>
        // ================= ROUTE PLANNER & ELEVATION CANVAS =================
        let topoCanvas, topoCtx;

        function initTopoCanvas() {
            topoCanvas = document.getElementById('topoMapCanvas');
            if (!topoCanvas) return;

            topoCanvas.width = topoCanvas.parentElement.clientWidth;
            topoCanvas.height = topoCanvas.parentElement.clientHeight;
            topoCtx = topoCanvas.getContext('2d');

            topoCanvas.onclick = function(e) {
                const rect = topoCanvas.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                // Simulated elevation based on radial distance from top-left peak center
                const distToPeak = Math.hypot(x - 150, y - 100);
                const alt = Math.max(1200, Math.round(4200 - distToPeak * 6));

                routeWaypoints.push({ x, y, alt });
                drawTopoMap();
                updateElevationChart();
            };

            drawTopoMap();
            initChartJS();
        }

        function drawTopoMap() {
            if (!topoCtx) return;
            const w = topoCanvas.width;
            const h = topoCanvas.height;

            topoCtx.clearRect(0, 0, w, h);

            // Draw Topographical Contour Lines
            topoCtx.strokeStyle = 'rgba(255, 255, 255, 0.06)';
            topoCtx.lineWidth = 1.5;
            for (let r = 30; r < 600; r += 35) {
                topoCtx.beginPath();
                topoCtx.arc(150, 100, r, 0, Math.PI * 2);
                topoCtx.stroke();
            }

            // Draw Trail Waypoint Line
            if (routeWaypoints.length > 0) {
                topoCtx.strokeStyle = '#10b981';
                topoCtx.lineWidth = 3;
                topoCtx.setLineDash([6, 6]);
                topoCtx.beginPath();
                topoCtx.moveTo(routeWaypoints[0].x, routeWaypoints[0].y);

                for (let i = 1; i < routeWaypoints.length; i++) {
                    topoCtx.lineTo(routeWaypoints[i].x, routeWaypoints[i].y);
                }
                topoCtx.stroke();
                topoCtx.setLineDash([]);

                // Draw Dots
                routeWaypoints.forEach((wp, index) => {
                    topoCtx.fillStyle = index === 0 ? '#3b82f6' : (index === routeWaypoints.length - 1 ? '#f59e0b' : '#10b981');
                    topoCtx.beginPath();
                    topoCtx.arc(wp.x, wp.y, 6, 0, Math.PI * 2);
                    topoCtx.fill();
                    topoCtx.strokeStyle = '#ffffff';
                    topoCtx.lineWidth = 2;
                    topoCtx.stroke();
                });
            }
        }

        function initChartJS() {
            const ctx = document.getElementById('elevationChart');
            if (!ctx) return;

            elevationChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Start'],
                    datasets: [{
                        label: 'Elevation (meters)',
                        data: [1200],
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.15)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8' } },
                        y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8' } }
                    }
                }
            });
        }

        function updateElevationChart() {
            if (!elevationChartInstance) return;

            const labels = routeWaypoints.map((_, i) => `WP ${i + 1}`);
            const data = routeWaypoints.map(wp => wp.alt);

            elevationChartInstance.data.labels = labels;
            elevationChartInstance.data.datasets[0].data = data;
            elevationChartInstance.update();

            // Compute Route Stats
            let totalDistKm = 0;
            let totalGain = 0;

            for (let i = 1; i < routeWaypoints.length; i++) {
                const p1 = routeWaypoints[i - 1];
                const p2 = routeWaypoints[i];
                const dx = p2.x - p1.x;
                const dy = p2.y - p1.y;
                const distPx = Math.hypot(dx, dy);

                totalDistKm += distPx * 0.025; // Scale px to km
                if (p2.alt > p1.alt) {
                    totalGain += (p2.alt - p1.alt);
                }
            }

            document.getElementById('metricDistance').textContent = `${totalDistKm.toFixed(1)} km`;
            document.getElementById('chartTotalDist').textContent = `${totalDistKm.toFixed(1)} km Total`;
            document.getElementById('metricAscent').textContent = `+${Math.round(totalGain)} m`;

            const estHours = (totalDistKm / 3) + (totalGain / 400);
            const hrs = Math.floor(estHours);
            const mins = Math.round((estHours - hrs) * 60);
            document.getElementById('metricTime').textContent = `${hrs}h ${mins}m`;

            const grade = totalDistKm > 0 ? ((totalGain / (totalDistKm * 1000)) * 100).toFixed(1) : 0;
            document.getElementById('metricGrade').textContent = `${grade}%`;

            // Update Waypoint List
            const listEl = document.getElementById('waypointsList');
            document.getElementById('waypointCount').textContent = routeWaypoints.length;

            if (routeWaypoints.length === 0) {
                listEl.innerHTML = `<p class="text-slate-500 italic p-2">No waypoints dropped yet. Click map to start route.</p>`;
            } else {
                listEl.innerHTML = routeWaypoints.map((wp, idx) => `
                    <div class="flex items-center justify-between p-2 rounded bg-slate-900 border border-slate-800 text-slate-300">
                        <span><i class="fa-solid fa-location-dot text-emerald-400 mr-2"></i>Waypoint ${idx + 1}</span>
                        <span class="font-bold text-slate-100">${wp.alt} m</span>
                    </div>
                `).join('');
            }
        }

        function clearWaypoints() {
